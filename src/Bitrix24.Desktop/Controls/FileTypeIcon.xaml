<UserControl x:Class="Bitrix24.Desktop.Controls.FileTypeIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="36" Height="36" IsHitTestVisible="False">
  <!-- Glyphs from LibreChat (MIT): packages/client/src/svgs/*Paths.tsx -->
  <UserControl.Resources>
    <Style x:Key="FileGlyph" TargetType="Path">
      <Setter Property="Stroke" Value="White"/>
      <Setter Property="StrokeThickness" Value="1.66667"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>
    <Style x:Key="FileWave" TargetType="Path" BasedOn="{StaticResource FileGlyph}">
      <Setter Property="StrokeThickness" Value="2"/>
    </Style>
  </UserControl.Resources>
  <Viewbox Stretch="Fill">
    <Canvas Width="36" Height="36">
      <Rectangle x:Name="Tile" Width="36" Height="36" RadiusX="6" RadiusY="6"/>
      <Canvas x:Name="GenericGlyph">
        <Path Style="{StaticResource FileGlyph}" Data="M18.833 9.66663H12.9997C12.5576 9.66663 12.1337 9.84222 11.8212 10.1548C11.5086 10.4673 11.333 10.8913 11.333 11.3333V24.6666C11.333 25.1087 11.5086 25.5326 11.8212 25.8451C12.1337 26.1577 12.5576 26.3333 12.9997 26.3333H22.9997C23.4417 26.3333 23.8656 26.1577 24.1782 25.8451C24.4907 25.5326 24.6663 25.1087 24.6663 24.6666V15.5L18.833 9.66663Z"/>
        <Path Style="{StaticResource FileGlyph}" Data="M18.833 9.66663V15.5H24.6663"/>
      </Canvas>
      <Canvas x:Name="DocumentGlyph">
        <Path Style="{StaticResource FileGlyph}" Data="M19.6663 9.66663H12.9997C12.5576 9.66663 12.1337 9.84222 11.8212 10.1548C11.5086 10.4673 11.333 10.8913 11.333 11.3333V24.6666C11.333 25.1087 11.5086 25.5326 11.8212 25.8451C12.1337 26.1577 12.5576 26.3333 12.9997 26.3333H22.9997C23.4417 26.3333 23.8656 26.1577 24.1782 25.8451C24.4907 25.5326 24.6663 25.1087 24.6663 24.6666V14.6666L19.6663 9.66663Z"/>
        <Path Style="{StaticResource FileGlyph}" Data="M19.667 9.66663V14.6666H24.667"/>
        <Path Style="{StaticResource FileGlyph}" Data="M21.3337 18.8334H14.667"/>
        <Path Style="{StaticResource FileGlyph}" Data="M21.3337 22.1666H14.667"/>
        <Path Style="{StaticResource FileGlyph}" Data="M16.3337 15.5H15.5003H14.667"/>
      </Canvas>
      <Canvas x:Name="SheetGlyph">
        <Path Style="{StaticResource FileGlyph}" Data="M15.5 10.5H12.1667C11.2462 10.5 10.5 11.2462 10.5 12.1667V13.5V18M15.5 10.5H23.8333C24.7538 10.5 25.5 11.2462 25.5 12.1667V13.5V18M15.5 10.5V25.5M15.5 25.5H18H23.8333C24.7538 25.5 25.5 24.7538 25.5 23.8333V18M15.5 25.5H12.1667C11.2462 25.5 10.5 24.7538 10.5 23.8333V18M10.5 18H25.5"/>
      </Canvas>
      <Canvas x:Name="CodeGlyph">
        <Path Style="{StaticResource FileGlyph}" Data="M21.333 23L26.333 18L21.333 13"/>
        <Path Style="{StaticResource FileGlyph}" Data="M14.667 13L9.66699 18L14.667 23"/>
      </Canvas>
      <Canvas x:Name="AudioGlyph">
        <Path Style="{StaticResource FileWave}" Data="M8 15v6"/>
        <Path Style="{StaticResource FileWave}" Data="M13 8v20"/>
        <Path Style="{StaticResource FileWave}" Data="M18 10v16"/>
        <Path Style="{StaticResource FileWave}" Data="M23 6v24"/>
        <Path Style="{StaticResource FileWave}" Data="M28 12v12"/>
      </Canvas>
      <Canvas x:Name="VideoGlyph">
        <Rectangle Width="20" Height="16" RadiusX="3" RadiusY="3" Canvas.Left="8" Canvas.Top="10" Fill="Transparent" Stroke="White" StrokeThickness="2"/>
        <Path Fill="White" Data="M22 18l-6 4v-8L22 18z"/>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
