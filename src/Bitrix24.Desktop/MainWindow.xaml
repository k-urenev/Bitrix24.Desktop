                  </Canvas>
                </Viewbox>
              </Button>
              <Border>
                <Grid x:Name="ComposerHost" VerticalAlignment="Center">
                <controls:EmojiBox x:Name="Composer"
                         VerticalAlignment="Center"
                         FontSize="15"
                         Foreground="{StaticResource Ink}"
                         CaretBrush="{StaticResource Ink}"
                         PlainText="{Binding Composer, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="20"
                         MaxHeight="160"
                         Padding="6,0,8,0"
                         Background="{StaticResource Surface}"
                         BorderThickness="0"
                         AllowDrop="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="OnComposerKeyDown"/>
                <TextBlock x:Name="ComposerHint" Text="Написать сообщение..." Foreground="{StaticResource Muted}" FontSize="15"
                           IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasComposer, Converter={StaticResource VisibleWhenFalse}}">
                  <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ComposerHintShift"/>
                  </TextBlock.RenderTransform>
                </TextBlock>
                </Grid>
              </Border>
            </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
        <Grid x:Name="FileDropHint" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False">
          <Border Margin="16" CornerRadius="12" Background="#99FFFFFF"/>
          <Rectangle Margin="16" RadiusX="12" RadiusY="12" Fill="Transparent"
                     Stroke="{StaticResource LinkInk}" StrokeThickness="4"
                     StrokeDashArray="2 1" SnapsToDevicePixels="True"/>
          <TextBlock Text="Отпустите файлы здесь" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="NoticesPage" Grid.Row="1" Background="{StaticResource Surface}" IsVisibleChanged="OnNoticesPageVisible"
          Visibility="{Binding IsChecked, ElementName=NoticesNav, Converter={StaticResource VisibleWhenTrue}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Уведомления" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,12" TextWrapping="Wrap"/>
      <Grid Grid.Row="1" Background="#FAFCFD">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding TaskNotices}" Margin="15,4,15,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TaskNoticeItem}">
                <Border Background="White" CornerRadius="20" Padding="15,10,15,9" Margin="0,0,0,15"
                        Cursor="Hand" MouseLeftButtonUp="OnOpenTaskNotice">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#000000"/>
                  </Border.Effect>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Top">
                      <Ellipse Fill="{Binding Color, Converter={StaticResource HexBrush}}"/>
                      <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Body}" FontSize="14" Foreground="#333333" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding When}" FontSize="13" Foreground="#C9CCD0" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="Пока нет уведомлений по задачам"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{StaticResource Muted}"
                   FontSize="15"
                   Margin="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasTaskNotices, Converter={StaticResource VisibleWhenFalse}}"/>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Background="{StaticResource Surface}"
          Visibility="{Binding IsChecked, ElementName=SettingsNav, Converter={StaticResource VisibleWhenTrue}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Настройки" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,12" TextWrapping="Wrap"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,8,24,24">
        <CheckBox Content="Запускать с компьютером"
                  IsChecked="{Binding LaunchWithWindows, Mode=TwoWay}"
                  FontSize="15"
                  HorizontalAlignment="Left"/>
        <CheckBox IsChecked="{Binding StartInTray, Mode=TwoWay}"
                  FontSize="15"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
          <TextBlock Text="Запускаться свернутым (появляться только в трее)" TextWrapping="Wrap"/>
        </CheckBox>
        <RadioButton GroupName="SendKey" FontSize="15" Margin="0,20,0,8"
                     IsChecked="{Binding SendOnEnter, Converter={StaticResource SendWithCtrlEnter}, Mode=TwoWay}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
          <TextBlock Text="Отправлять Ctrl+Enter, Перенос Enter" TextWrapping="Wrap"/>
        </RadioButton>
        <RadioButton GroupName="SendKey" FontSize="15"
                     IsChecked="{Binding SendOnEnter, Converter={StaticResource SendWithEnter}, Mode=TwoWay}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
          <TextBlock Text="Отправлять Enter, Перенос Ctrl+Enter" TextWrapping="Wrap"/>
        </RadioButton>
        <TextBlock Text="{Binding LaunchWithWindowsNote}" TextWrapping="Wrap" Foreground="{StaticResource Danger}" Margin="0,8,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Grid Margin="0,20,0,0">
          <Border BorderBrush="{StaticResource Date}" BorderThickness="1" CornerRadius="10"
                  Padding="16,18,16,10" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding SoundChoices}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NoticeSoundChoice}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="SoundLabel"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" IsReadOnly="True" IsTabStop="False" Cursor="Hand"
                             Text="{Binding FileLabel, Mode=OneWay}" ToolTip="{Binding FullPath}"
                             FontSize="15" Padding="12,4" MinHeight="30"
                             VerticalContentAlignment="Center"
                             PreviewMouseLeftButtonUp="OnPickNoticeSound"/>
                    <Button Grid.Column="2" Content="Обзор" Margin="8,0,0,0" Padding="12,4" MinHeight="30"
                            VerticalAlignment="Center" Click="OnPickNoticeSound"/>
                    <Button Grid.Column="3" Content="Сброс" Margin="8,0,0,0" Padding="12,4" MinHeight="30"
                            VerticalAlignment="Center" Click="OnClearNoticeSound"
                            Visibility="{Binding HasCustom, Converter={StaticResource VisibleWhenTrue}}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border Background="{StaticResource Surface}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,0,0,0" Padding="8,0">
            <TextBlock Text="Звуки" FontSize="15"/>
          </Border>
        </Grid>
      </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="{Binding AppVersion}" FontSize="8" Foreground="{StaticResource Muted}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,8"/>
    </Grid>

    <Grid Grid.Row="1" Background="{StaticResource Surface}"
          Visibility="{Binding IsChecked, ElementName=AboutNav, Converter={StaticResource VisibleWhenTrue}}">
      <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="О программе" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Битрикс24" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Неофициальная сборка Битрикс24 Мессенджера" FontSize="15" Foreground="{StaticResource Muted}"
                   Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding AppVersion, StringFormat=Версия {0}}" FontSize="15" Foreground="{StaticResource Muted}"
                   Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Button Content="Обновить" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                HorizontalAlignment="Center" Margin="0,16,0,0" AutomationProperties.Name="Обновить"/>
        <TextBlock Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center">
          <Hyperlink Click="OnSupportArchive" Foreground="{StaticResource LinkInk}"
                     AutomationProperties.Name="Архив для техподдержки">Архив для техподдержки</Hyperlink>
        </TextBlock>
        <TextBlock Text="{Binding SupportArchiveNote}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{StaticResource Danger}" Margin="0,8,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Grid>

    <Popup x:Name="ReactionPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="Transparent" Padding="0,6,0,12" MouseEnter="OnReactionPopupEnter" MouseLeave="OnReactionPopupLeave">
      <Border Background="White" CornerRadius="16" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <ItemsControl x:Name="ReactionChoices" Width="304">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:ReactionChoice}">
              <Button Width="38" Height="38" Cursor="Hand" ToolTip="{Binding Title}" Click="OnPickReaction" ToolTipService.InitialShowDelay="400">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Cell" Background="Transparent" CornerRadius="10">
                      <Image Width="34" Height="34" Source="{Binding Image}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Cell" Property="Background" Value="#F0F2F4"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      </Border>
    </Popup>
    <Popup x:Name="EmojiPopup" Placement="Top" PlacementTarget="{Binding ElementName=EmojiButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <controls:EmojiPicker Chosen="OnEmojiChosen"/>
    </Popup>
    </Grid>
    <Grid x:Name="PictureLayer" Grid.ColumnSpan="2" Panel.ZIndex="30" Visibility="Collapsed"
          Background="#CC1C1E22" MouseLeftButtonDown="OnPictureLayerClick" PreviewMouseWheel="OnPictureWheel">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,0">
        <Button x:Name="PictureDownload" Width="56" Height="56" Foreground="#99FFFFFF" Cursor="Hand" Click="OnPictureDownload"
                ToolTip="Скачать" AutomationProperties.Name="Скачать">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Edge" Background="Transparent" CornerRadius="8">
                <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Fill="{TemplateBinding Foreground}" Data="M5,20h14v-2H5V20z M19,9h-4V3H9v6H5l7,7L19,9z"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Edge" Property="Background" Value="#33FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button Width="56" Height="56" Foreground="#99FFFFFF" Cursor="Hand" Click="OnPictureClose"
                ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Edge" Background="Transparent" CornerRadius="8">
                <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Fill="{TemplateBinding Foreground}" Data="M19,6.41 L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Edge" Property="Background" Value="#33FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
      <Image x:Name="PictureView" Grid.Row="1" Margin="24,8,24,24" Stretch="Uniform"
             RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
  </Grid>
</Window>
