<Window x:Class="Bitrix24.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bitrix24.Desktop.ViewModels"
        xmlns:controls="clr-namespace:Bitrix24.Desktop.Controls"
        xmlns:local="clr-namespace:Bitrix24.Desktop"
        Title="Битрикс24"
        Width="1112"
        Height="640"
        MinWidth="952"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
          <RadioButton x:Name="ChatsNav" Style="{StaticResource SideRailButton}" GroupName="Shell" IsChecked="True"
                       ToolTip="Чаты" AutomationProperties.Name="Чаты">
            <Grid Width="36" Height="28">
              <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="None"
                      Data="M20,2 H4 C2.9,2 2,2.9 2,4 V22 L6,18 H20 C21.1,18 22,17.1 22,16 V4 C22,2.9 21.1,2 20,2 Z"/>
              </Canvas>
              <Border MinWidth="18" MinHeight="18" CornerRadius="9" Padding="4,0" Margin="0,-6,-6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="{StaticResource UnreadRed}"
                      Visibility="{Binding HasUnreadMessages, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{Binding UnreadMessageLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NoticesNav" Style="{StaticResource SideRailButton}" GroupName="Shell"
                       ToolTip="Уведомления" AutomationProperties.Name="Уведомления">
            <Grid Width="36" Height="28">
              <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="None"
                      Data="M12,22 C13.1,22 14,21.1 14,20 H10 C10,21.1 10.9,22 12,22 Z M18,16 V11 C18,7.93 16.36,5.36 13.5,4.68 V4 C13.5,3.17 12.83,2.5 12,2.5 C11.17,2.5 10.5,3.17 10.5,4 V4.68 C7.63,5.36 6,7.92 6,11 V16 L4,18 V19 H20 V18 L18,16 Z"/>
              </Canvas>
              <Border MinWidth="18" MinHeight="18" CornerRadius="9" Padding="4,0" Margin="0,-6,-6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="{StaticResource Accent}"
                      Visibility="{Binding HasUnreadNotices, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{Binding UnreadNoticeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" Style="{StaticResource SideRailButton}" GroupName="Shell"
                       ToolTip="Настройки" AutomationProperties.Name="Настройки">
            <Canvas Width="24" Height="24">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="None">
                <Path.Data>
                  <PathGeometry FillRule="EvenOdd" Figures="M19.14,12.94 C19.18,12.63 19.2,12.31 19.2,12 C19.2,11.69 19.18,11.37 19.14,11.06 L21.17,9.48 C21.35,9.34 21.4,9.07 21.29,8.87 L19.37,5.55 C19.25,5.33 19,5.26 18.78,5.33 L16.39,6.29 C15.87,5.89 15.31,5.56 14.7,5.31 L14.34,2.77 C14.3,2.53 14.1,2.36 13.86,2.36 H10.02 C9.78,2.36 9.59,2.53 9.55,2.77 L9.19,5.31 C8.58,5.56 8.02,5.89 7.5,6.29 L5.11,5.33 C4.89,5.25 4.64,5.33 4.52,5.55 L2.6,8.87 C2.48,9.08 2.54,9.34 2.72,9.48 L4.75,11.06 C4.71,11.37 4.69,11.69 4.69,12 C4.69,12.31 4.71,12.63 4.75,12.94 L2.72,14.52 C2.54,14.66 2.48,14.93 2.6,15.13 L4.52,18.45 C4.64,18.67 4.89,18.74 5.11,18.67 L7.5,17.71 C8.02,18.11 8.58,18.44 9.19,18.69 L9.55,21.23 C9.59,21.47 9.78,21.64 10.02,21.64 H13.86 C14.1,21.64 14.3,21.47 14.34,21.23 L14.7,18.69 C15.31,18.44 15.87,18.11 16.39,17.71 L18.78,18.67 C19,18.75 19.25,18.67 19.37,18.45 L21.29,15.13 C21.4,14.93 21.35,14.66 21.17,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"/>
                </Path.Data>
              </Path>
            </Canvas>
          </RadioButton>
          <RadioButton x:Name="AboutNav" Style="{StaticResource SideRailButton}" GroupName="Shell"
                       ToolTip="О программе" AutomationProperties.Name="О программе">
            <Canvas Width="24" Height="24">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="None">
                <Path.Data>
                  <PathGeometry FillRule="EvenOdd" Figures="M11,18 H13 V16 H11 V18 Z M12,2 A10,10 0 0 0 2,12 A10,10 0 0 0 12,22 A10,10 0 0 0 22,12 A10,10 0 0 0 12,2 Z M12,20 A8,8 0 0 1 4,12 A8,8 0 0 1 12,4 A8,8 0 0 1 20,12 A8,8 0 0 1 12,20 Z M12,6 A4,4 0 0 0 8,10 H10 A2,2 0 0 1 12,8 A2,2 0 0 1 14,10 C14,12 11,11.75 11,15 H13 C13,12.75 16,12.5 16,10 A4,4 0 0 0 12,6 Z"/>
                </Path.Data>
              </Path>
            </Canvas>
          </RadioButton>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource SideRailAction}" Margin="0,0,0,8" Click="OnSignOutClick"
                ToolTip="Выйти из аккаунта" AutomationProperties.Name="Выйти из аккаунта">
          <Canvas Width="24" Height="24">
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None"
                  Data="M17,7 L15.59,8.41 L18.17,11 H8 V13 H18.17 L15.59,15.58 L17,17 L22,12 Z M4,5 H12 V3 H4 C2.9,3 2,3.9 2,5 V19 C2,20.1 2.9,21 4,21 H12 V19 H4 V5 Z"/>
          </Canvas>
        </Button>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16">
      <WrapPanel VerticalAlignment="Center">
        <Grid Width="42" Height="42" Margin="0,0,10,0" VerticalAlignment="Center">
          <Ellipse Fill="{Binding SelfColor, Converter={StaticResource HexBrush}}"/>
          <TextBlock Text="{Binding SelfInitials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Ellipse Visibility="{Binding HasSelfFace, Converter={StaticResource VisibleWhenTrue}}">
            <Ellipse.Fill>
              <ImageBrush ImageSource="{Binding SelfFace}" Stretch="UniformToFill"/>
            </Ellipse.Fill>
          </Ellipse>
        </Grid>
        <TextBlock Text="{Binding UserName}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Status}" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      </WrapPanel>
    </Border>

    <Grid x:Name="ChatsPage" Grid.Row="1" IsVisibleChanged="OnChatsPageVisible"
          Visibility="{Binding IsChecked, ElementName=ChatsNav, Converter={StaticResource VisibleWhenTrue}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Margin="13,16,13,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border MinWidth="28" MinHeight="34" Margin="0,0,8,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Fill="{StaticResource IconGray}" Stretch="None">
                  <Path.Data>
                    <PathGeometry FillRule="EvenOdd" Figures="M4.79804 8.09044C3.99077 7.11214 4.68664 5.63574 5.955 5.63574H18.066C19.3366 5.63574 20.0317 7.11664 19.22 8.09409L14.5867 13.673C14.4674 13.8166 14.4021 13.9974 14.4021 14.1841L14.4021 19.3369C14.4021 20.1342 13.639 20.7098 12.8724 20.4907L10.6748 19.8627C10.0309 19.6786 9.58696 19.0901 9.58696 18.4204L9.58696 14.1814C9.58696 13.9956 9.52227 13.8156 9.404 13.6722L4.79804 8.09044ZM5.85391 7.14842C5.85515 7.16035 5.85933 7.17692 5.87787 7.19939L10.4838 12.7812C10.8091 13.1753 10.987 13.6704 10.987 14.1814L10.987 18.4204C10.987 18.465 11.0166 18.5043 11.0595 18.5166L13.0021 19.0717L13.0021 14.1841C13.0021 13.6707 13.1817 13.1735 13.5097 12.7785L18.1429 7.19963C18.1616 7.17715 18.1658 7.16057 18.1671 7.14867C18.1687 7.13361 18.1662 7.11387 18.1565 7.09325C18.1469 7.07263 18.1332 7.05813 18.1206 7.04973C18.1107 7.04309 18.0952 7.03574 18.066 7.03574H5.955C5.92587 7.03574 5.91043 7.04306 5.90044 7.0497C5.88784 7.05809 5.87424 7.07255 5.86455 7.09311C5.85486 7.11366 5.85236 7.13336 5.85391 7.14842Z"/>
                  </Path.Data>
                </Path>
              </Canvas>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource FieldWash}" CornerRadius="17" Padding="10,5,8,5" MinHeight="34" VerticalAlignment="Center">
              <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Left" Width="24" MinHeight="24" Margin="0,0,4,0" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding HasSearch, Converter={StaticResource VisibleWhenFalse}}">
                    <Path Fill="{StaticResource IconGray}" Stretch="None">
                      <Path.Data>
                        <PathGeometry FillRule="EvenOdd" Figures="M15.0592 16.0491C13.8973 16.9731 12.4264 17.5252 10.8266 17.5252C7.06795 17.5252 4.021 14.4782 4.021 10.7196C4.021 6.96101 7.06795 3.91406 10.8266 3.91406C14.5852 3.91406 17.6321 6.96101 17.6321 10.7196C17.6321 12.3741 17.0417 13.8907 16.0601 15.0702L19.9948 19.0049C20.2682 19.2782 20.2682 19.7215 19.9948 19.9948C19.7215 20.2682 19.2782 20.2682 19.0049 19.9948L15.0592 16.0491ZM16.2321 10.7196C16.2321 13.705 13.812 16.1252 10.8266 16.1252C7.84115 16.1252 5.421 13.705 5.421 10.7196C5.421 7.73421 7.84115 5.31406 10.8266 5.31406C13.812 5.31406 16.2321 7.73421 16.2321 10.7196Z"/>
                      </Path.Data>
                    </Path>
                  </Canvas>
                  <Button Style="{StaticResource FieldClearButton}" MinWidth="24" MinHeight="24" Padding="0"
                          Click="OnClearSearchClick"
                          Visibility="{Binding HasSearch, Converter={StaticResource VisibleWhenTrue}}">
                    <Canvas Width="24" Height="24" IsHitTestVisible="False">
                      <Path Stretch="None" Stroke="{StaticResource IconGray}" StrokeThickness="1.6"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Data="M7.5 7.5 L16.5 16.5 M16.5 7.5 L7.5 16.5"/>
                    </Canvas>
                  </Button>
                </Grid>
                <Grid VerticalAlignment="Center">
                  <TextBox x:Name="SearchBox" Style="{StaticResource EmbeddedField}" FontSize="14" Padding="2,0" MinHeight="22"
                           Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                  <TextBlock Text="Найти сотрудника или чат" Foreground="{StaticResource Date}" FontSize="14" FontWeight="Normal" IsHitTestVisible="False"
                             VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding HasSearch, Converter={StaticResource VisibleWhenFalse}}"/>
                </Grid>
              </DockPanel>
            </Border>
          </Grid>
          <Grid>
            <ListBox x:Name="DialogList"
                     ItemsSource="{Binding DialogsView}"
                     SelectedItem="{Binding SelectedDialog, Mode=TwoWay}"
                     PreviewMouseLeftButtonUp="OnDialogClick"
                     ItemContainerStyle="{StaticResource DialogContainer}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8,0,8,8"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DialogItem}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Left">
                      <Ellipse Fill="{Binding Color, Converter={StaticResource HexBrush}}"/>
                      <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Ellipse Visibility="{Binding HasListFace, Converter={StaticResource VisibleWhenTrue}}">
                        <Ellipse.Fill>
                          <ImageBrush ImageSource="{Binding ListFace}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                      </Ellipse>
                    </Grid>
                    <Grid Grid.Column="1" Margin="13,0,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                  <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <controls:ReactionMark Width="12" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                                Visibility="{Binding ShowUnreadReaction, Converter={StaticResource VisibleWhenTrue}}"/>
                          <controls:ReceiptMark Viewed="{Binding ReceiptViewed}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                Visibility="{Binding ShowListReceipt, Converter={StaticResource VisibleWhenTrue}}">
                            <controls:ReceiptMark.Style>
                              <Style TargetType="controls:ReceiptMark">
                                <Setter Property="Fill" Value="{StaticResource IconGray}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ReceiptViewed}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource ViewedInk}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Fill" Value="White"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </controls:ReceiptMark.Style>
                          </controls:ReceiptMark>
                          <TextBlock Text="{Binding TimeLabel}" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Date}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="#B3FFFFFF"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" ClipToBounds="True" MaxHeight="38" Margin="0,0,8,0">
                          <controls:EmojiText Message="{Binding Preview}" EmojiSize="16" FontSize="14" LineHeight="19" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                            <controls:EmojiText.Style>
                              <Style TargetType="controls:EmojiText">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </controls:EmojiText.Style>
                          </controls:EmojiText>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                Visibility="{Binding HasUnread, Converter={StaticResource VisibleWhenTrue}}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource Accent}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                  <Setter Property="Background" Value="White"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding UnreadLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                      </Grid>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="ChatListShadow" Height="10" Opacity="0" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#1A000000" Offset="0"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Text="Пока нет диалогов. Они появятся после первого опроса портала."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"
                       Margin="16"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasDialogs, Converter={StaticResource VisibleWhenFalse}}"/>
          </Grid>
        </DockPanel>
      </Border>

      <Grid x:Name="ChatPane" Grid.Column="1" AllowDrop="True"
            PreviewDragEnter="OnChatFileDrag" PreviewDragOver="OnChatFileDrag"
            PreviewDragLeave="OnChatFileDragLeave" PreviewDrop="OnChatFileDrop">
        <Rectangle Fill="{StaticResource ChatCanvas}"/>
        <Rectangle Fill="{StaticResource ChatWash}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource ChatPattern}" IsHitTestVisible="False"/>
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.RowSpan="3"
                   Text="Выберите чат и начните общение"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Ink}"
                   Margin="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenFalse}}"/>

        <Border Grid.Row="0" Background="{StaticResource Surface}" Padding="15,11" MinHeight="64"
                Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
          <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,10,0" VerticalAlignment="Center">
              <Ellipse Fill="{Binding SelectedDialog.Color, Converter={StaticResource HexBrush}}"/>
              <TextBlock Text="{Binding SelectedDialog.Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Visibility="{Binding SelectedDialog.HasTalkFace, Converter={StaticResource VisibleWhenTrue}}">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="{Binding SelectedDialog.TalkFace}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedDialog.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           MouseLeftButtonUp="OnOpenPeerProfile">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Cursor" Value="Arrow"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedDialog.CanOpenProfile}" Value="True">
                          <Setter Property="Cursor" Value="Hand"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SelectedDialog.Presence}" FontSize="14" FontStyle="Italic" FontWeight="Normal"
                           Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding SelectedDialog.HasPresenceText, Converter={StaticResource VisibleWhenTrue}}"/>
              </WrapPanel>
              <TextBlock Text="{Binding SelectedDialog.Subtitle}" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
        <ListBox x:Name="MessagesList" ItemsSource="{Binding ChatRows}"
                 Background="Transparent" BorderThickness="0" Padding="16,8,16,16"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.Resources>
            <DataTemplate DataType="{x:Type vm:LoadOlderMarker}">
              <StackPanel>
                <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Margin="0,8,0,8"
                        Padding="12,4" MinHeight="28"
                        Command="{Binding DataContext.LoadOlderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        Visibility="{Binding DataContext.CanLoadOlder, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource VisibleWhenTrue}}">
                  <TextBlock Text="Загрузить раньше" TextWrapping="Wrap"/>
                </Button>
                <TextBlock Text="Обновляем переписку…" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource VisibleWhenTrue}}"/>
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MessageItem}">
                  <StackPanel Loaded="OnMessageRowReady" DataContextChanged="OnMessageRowContext">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding FadeOnOpen}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FadeOnArrive}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource DayLabel}" Margin="0,12,0,4"
                            Visibility="{Binding HasDay, Converter={StaticResource VisibleWhenTrue}}">
                      <TextBlock Text="{Binding DayLabel}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="Transparent" Padding="12,8" Margin="0,2,0,0" MouseEnter="OnMessageEnter" MouseMove="OnMessageMove" MouseLeave="OnMessageLeave">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid x:Name="Avatar" Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Bottom" Visibility="Collapsed">
                        <Grid Visibility="{Binding ShowAvatar, Converter={StaticResource VisibleWhenTrue}}">
                          <Ellipse Fill="{Binding Color, Converter={StaticResource HexBrush}}"/>
                          <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource VisibleWhenTrue}}">
                            <Ellipse.Fill>
                              <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                          </Ellipse>
                        </Grid>
                      </Grid>
                      <StackPanel x:Name="MessageLine" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                      <Button x:Name="ReactBefore" Width="40" Height="34" Margin="0,0,8,0" VerticalAlignment="Bottom"
                              Visibility="Collapsed" Cursor="Hand" AutomationProperties.Name="Реакция"
                              Click="OnReactClick" MouseEnter="OnReactEnter">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="Transparent" CornerRadius="17" Width="40" Height="34">
                              <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="26" Height="26" Fill="#EDEEF0"/>
                                <Ellipse Width="3" Height="3" Fill="#A8ADB4" Canvas.Left="7" Canvas.Top="9"/>
                                <Ellipse Width="3" Height="3" Fill="#A8ADB4" Canvas.Left="16" Canvas.Top="9"/>
                                <Path Stroke="#A8ADB4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,16 Q13,21 19,16"/>
                              </Canvas>
                            </Border>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                      <Border x:Name="Bubble" Padding="12,8,12,6" CornerRadius="6,10,10,0" HorizontalAlignment="Left"
                              ToolTip="Правая кнопка открывает меню действий, удержание Ctrl цитирует сообщение целиком."
                              PreviewMouseLeftButtonDown="OnMessageQuote"
                              ContextMenuOpening="OnMessageMenu"
                              MinWidth="{Binding BubbleMinWidth}" MaxWidth="{Binding BubbleWidth}"
                              Background="{StaticResource Surface}" BorderThickness="0">
                        <controls:BubbleLayout>
                          <TextBlock x:Name="Author" Text="{Binding Author}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"
                                     Foreground="{Binding Color, Converter={StaticResource HexBrush}}"
                                     Visibility="{Binding ShowAuthor, Converter={StaticResource VisibleWhenTrue}}"/>
                          <ItemsControl ItemsSource="{Binding Files}" Visibility="{Binding HasFiles, Converter={StaticResource VisibleWhenTrue}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:FileItem}">
                                <StackPanel Margin="0,4,0,0">
                                  <Image Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" Stretch="Uniform" HorizontalAlignment="Left" Source="{Binding Picture}"
                                         Cursor="Hand" MouseLeftButtonUp="OnOpenPicture" RenderOptions.BitmapScalingMode="HighQuality"
                                         Visibility="{Binding HasFrame, Converter={StaticResource VisibleWhenTrue}}"/>
                                  <Button Style="{StaticResource GhostButton}" Margin="0,4,0,0" Click="OnOpenFileClick" IsEnabled="{Binding HasLink}">
                                    <DockPanel>
                                      <controls:FileTypeIcon DockPanel.Dock="Left" FileName="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                      <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="{StaticResource TimeInk}" Margin="0,3,0,0"
                                                   Visibility="{Binding HasSize, Converter={StaticResource VisibleWhenTrue}}"/>
                                      </StackPanel>
                                    </DockPanel>
                                  </Button>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <controls:MessageBody Message="{Binding Text}" CanEdit="{Binding CanEdit}" EditRequested="OnEditMessage"
                                     QuoteRequested="OnQuoteRequested"
                                     FontSize="15" Foreground="{StaticResource Ink}"
                                     Visibility="{Binding HasText, Converter={StaticResource VisibleWhenTrue}}"/>
                          <Border Margin="0,8,0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnOpenLinkPreview"
                                  controls:BubbleLayout.Fill="True"
                                  Visibility="{Binding HasLinkPreview, Converter={StaticResource VisibleWhenTrue}}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Width="49.8" Height="49.8" Margin="0,0,8,0" ClipToBounds="True"
                                      Visibility="{Binding HasLinkImage, Converter={StaticResource VisibleWhenTrue}}">
                                <Image Width="49.8" Height="49.8" Source="{Binding LinkImage}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                              </Border>
                              <Border Grid.Column="1" VerticalAlignment="Top" Background="Transparent">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="ClipToBounds" Value="False"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding HasLinkImage}" Value="True">
                                        <Setter Property="Height" Value="49.8"/>
                                        <Setter Property="ClipToBounds" Value="True"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <StackPanel>
                                  <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLinkImage}" Value="True">
                                          <Setter Property="Margin" Value="0,-1.95,0,0"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </StackPanel.Style>
                                  <TextBlock Text="{Binding LinkTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#11A9D9"
                                             LineHeight="16.9" LineStackingStrategy="BlockLineHeight"
                                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                  <TextBlock Text="{Binding LinkDescription}" FontSize="13" Foreground="#828B95"
                                             LineHeight="16.9" LineStackingStrategy="BlockLineHeight"
                                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36.8"
                                             Visibility="{Binding HasLinkDescription, Converter={StaticResource VisibleWhenTrue}}"/>
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Border>
                          <DockPanel Margin="0,4,0,0" LastChildFill="True" controls:BubbleLayout.Grow="True">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                      controls:BubbleLayout.Floor="True"
                                      Visibility="{Binding HasTime, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="изменено" FontSize="10" Foreground="{StaticResource TimeInk}" Margin="0,0,6,0" VerticalAlignment="Bottom"
                                       Visibility="{Binding IsEdited, Converter={StaticResource VisibleWhenTrue}}"/>
                            <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="{StaticResource TimeInk}" VerticalAlignment="Bottom"/>
                            <controls:ReceiptMark Viewed="{Binding IsViewed}" Margin="4,0,0,0" VerticalAlignment="Bottom"
                                                  Visibility="{Binding ShowReceipt, Converter={StaticResource VisibleWhenTrue}}">
                              <controls:ReceiptMark.Style>
                                <Style TargetType="controls:ReceiptMark">
                                  <Setter Property="Fill" Value="{StaticResource TimeInk}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewed}" Value="True">
                                      <Setter Property="Fill" Value="{StaticResource ViewedInk}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </controls:ReceiptMark.Style>
                            </controls:ReceiptMark>
                          </StackPanel>
                          <ItemsControl x:Name="ReactionList" Margin="0,2,8,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        ItemsSource="{Binding Reactions}"
                                        Visibility="{Binding HasReactions, Converter={StaticResource VisibleWhenTrue}}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:ReactionChip}">
                                <Button Click="OnChipClick" Margin="0,0,8,0" Cursor="Hand" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="500">
                                  <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                      <Border x:Name="Chip" Background="Transparent" BorderBrush="#2FC6F6" BorderThickness="1" CornerRadius="13" Padding="5">
                                        <StackPanel Orientation="Horizontal">
                                          <Image Width="{Binding IconWidth}" Height="{Binding IconHeight}" Source="{Binding Image}" VerticalAlignment="Center" IsHitTestVisible="False"
                                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                                          <ItemsControl ItemsSource="{Binding Faces}" Margin="{Binding FaceGap}" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowFaces, Converter={StaticResource VisibleWhenTrue}}">
                                            <ItemsControl.ItemsPanel>
                                              <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                              </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate DataType="{x:Type vm:ReactionFace}">
                                                <Grid Width="{Binding DataContext.IconHeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Height="{Binding DataContext.IconHeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Margin="{Binding Margin}">
                                                  <TextBlock Text="{Binding Initials}" FontSize="7" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                  <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource VisibleWhenTrue}}">
                                                    <Ellipse.Fill>
                                                      <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                  </Ellipse>
                                                </Grid>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                          <Grid Margin="8,0,0,0" Height="{Binding IconHeight}" ClipToBounds="True" VerticalAlignment="Center"
                                                Visibility="{Binding ShowCount, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Text="{Binding Count}" FontSize="13" Foreground="#333333" VerticalAlignment="Center"/>
                                          </Grid>
                                        </StackPanel>
                                      </Border>
                                    </ControlTemplate>
                                  </Button.Template>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          </DockPanel>
                        </controls:BubbleLayout>
                      </Border>
                      <Button x:Name="ReactAfter" Width="40" Height="34" Margin="8,0,0,0" VerticalAlignment="Bottom"
                              Visibility="Collapsed" Cursor="Hand" AutomationProperties.Name="Реакция"
                              Click="OnReactClick" MouseEnter="OnReactEnter">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="Transparent" CornerRadius="17" Width="40" Height="34">
                              <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="26" Height="26" Fill="#EDEEF0"/>
                                <Ellipse Width="3" Height="3" Fill="#A8ADB4" Canvas.Left="7" Canvas.Top="9"/>
                                <Ellipse Width="3" Height="3" Fill="#A8ADB4" Canvas.Left="16" Canvas.Top="9"/>
                                <Path Stroke="#A8ADB4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,16 Q13,21 19,16"/>
                              </Canvas>
                            </Border>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                      </StackPanel>
                    </Grid>
                    </Border>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMine}" Value="False">
                      <Setter TargetName="Avatar" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                      <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="MessageLine" Property="HorizontalAlignment" Value="Center"/>
                      <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                      <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                      <Setter TargetName="Author" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                      <Setter TargetName="Avatar" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="Avatar" Property="Grid.Column" Value="2"/>
                      <Setter TargetName="Avatar" Property="Margin" Value="12,0,0,0"/>
                      <Setter TargetName="MessageLine" Property="HorizontalAlignment" Value="Right"/>
                      <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                      <Setter TargetName="Bubble" Property="Background" Value="{StaticResource MineBubble}"/>
                      <Setter TargetName="Bubble" Property="CornerRadius" Value="10,6,0,10"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowReact}" Value="True"/>
                        <Condition Binding="{Binding IsMine}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="ReactBefore" Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowReact}" Value="True"/>
                        <Condition Binding="{Binding IsMine}" Value="False"/>
                        <Condition Binding="{Binding IsSystem}" Value="False"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="ReactAfter" Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="Stretch"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
        <Border x:Name="StickyDay" Style="{StaticResource DayLabel}" VerticalAlignment="Top" Margin="0,8,0,0"
                IsHitTestVisible="False" Visibility="Collapsed">
          <TextBlock x:Name="StickyDayText" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
        </Border>
        <Button x:Name="JumpLatest" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"
                MinWidth="44" MinHeight="44" Opacity="0" Cursor="Hand" Visibility="Collapsed" Panel.ZIndex="1"
                Click="OnJumpLatestClick" ToolTip="К новому сообщению" AutomationProperties.Name="К новому сообщению">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Face" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="22" Width="44" Height="44">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <Canvas Width="42" Height="42">
                  <Path Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Data="M11,19 L21,27 L31,19"/>
                </Canvas>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Face" Property="Background" Value="{StaticResource Hover}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        </Grid>

        <StackPanel Grid.Row="2" Margin="18,6,18,12" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
          <TextBlock Text="печатает" FontSize="10" Foreground="{StaticResource Ink}" Margin="6,0,0,6"
                     Visibility="{Binding HasTyping, Converter={StaticResource VisibleWhenTrue}}"/>
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Danger}" Margin="0,0,0,8"
                     Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}"/>
          <ItemsControl ItemsSource="{Binding PendingFiles}" Margin="0,0,0,8"
                        Visibility="{Binding HasPendingFiles, Converter={StaticResource VisibleWhenTrue}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PendingAttachment}">
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Margin="16,0,0,0" VerticalAlignment="Top"
                          Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="Убрать" TextWrapping="Wrap"/>
                  </Button>
                  <controls:FileTypeIcon DockPanel.Dock="Left" FileName="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="8,8,8,8">
            <StackPanel>
            <Border Margin="4,0,4,8" Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource FieldClearButton}" Margin="8,0,0,0"
                        Command="{Binding CancelEditCommand}" ToolTip="Отмена" AutomationProperties.Name="Отмена">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" Foreground="{StaticResource Date}"/>
                </Button>
                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="16"
                           Foreground="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Редактировать сообщение" Foreground="{StaticResource Accent}" FontSize="13"/>
                  <TextBlock Text="{Binding EditPreview}" Foreground="{StaticResource Ink}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                      Command="{Binding SendCommand}" AutomationProperties.Name="{Binding SendName}" ToolTip="{Binding SendTip}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding SendIcon}" FontSize="14" Foreground="White"/>
              </Button>
              <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="0,0,4,0" VerticalAlignment="Center" Click="OnAttachClick" ToolTip="Файл" AutomationProperties.Name="Файл">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE16C;" FontSize="16" Foreground="{StaticResource Date}"/>
              </Button>
              <Button x:Name="EmojiButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="0,0,4,0" VerticalAlignment="Center" Click="OnEmojiClick" ToolTip="Смайл" AutomationProperties.Name="Смайл">
                <Viewbox Width="24" Height="24">
                  <Canvas Width="24" Height="24">
